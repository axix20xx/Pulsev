# Germany (وب)
client
dev tun
nobind
remote opengermany.proazsv.shop 1821 udp
remote opengermany.proazsv.shop 8371 tcp
server-poll-timeout 5
connect-retry 2 10
resolv-retry infinite
persist-key
persist-tun
remote-cert-tls server
tls-version-min 1.2
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
cipher AES-256-GCM
setenv opt block-outside-dns
verb 3
explicit-exit-notify 1
