# Germany (وب)
client
dev tun
nobind
remote opengermany.asan-ps.ir 1821 udp
remote opengermany.asan-ps.ir 8371 tcp
remote opengermanypro.asan-ps.ir 1194 udp
remote opengermanypro.asan-ps.ir 3451 tcp
server-poll-timeout 5
connect-retry 2 10
resolv-retry infinite
persist-key
persist-tun
remote-cert-tls server
tls-version-min 1.2
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305
cipher AES-256-GCM
setenv opt block-outside-dns
verb 3
explicit-exit-notify 1
