{
  "expo": {
    "name": "Pulse VPN Client",
    "slug": "pulse-vpn-client",
    "version": "1.5.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulse-vpn-client",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.pulse.vpnclient",
      "supportsTablet": false,
      "entitlements": {
        "com.apple.developer.networking.networkextension": [
          "packet-tunnel-provider"
        ],
        "com.apple.security.application-groups": [
          "group.com.pulse.vpnclient"
        ],
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)com.pulse.vpnclient.shared"
        ]
      },
      "infoPlist": {
        "PulseKeychainAccessGroup": "$(AppIdentifierPrefix)com.pulse.vpnclient.shared"
      }
    },
    "android": {
      "package": "com.pulse.vpnclient",
      "versionCode": 50
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-splash-screen",
      "./plugins/with-pulse-vpn-packages.js",
      [
        "@bacons/apple-targets",
        {
          "root": "./targets"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
