{
  "expo": {
    "name": "Pulse VPN Client",
    "slug": "pulse-vpn-client",
    "version": "1.0.22",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pulse-vpn-client",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.pulse.vpnclient",
      "versionCode": 23
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "autolinking": {
      "nativeModulesDir": "./modules"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
