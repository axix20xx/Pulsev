NODE_ENV=production
PORT=3000
API_INTERNAL_PORT=3001
# Internal API startup timeout and automatic health-check interval (milliseconds).
API_STARTUP_TIMEOUT_MS=180000
API_HEALTH_INTERVAL_MS=30000

# Supabase Postgres connection string. Prefer the Supabase pooler URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Must be the same value used when the imported Provider credentials were saved.
# If the original value is unavailable, keep a new long random value and re-save
# every Provider credential from Settings after the first login.
SESSION_SECRET=replace-with-a-long-random-value

# Telegram Login
TELEGRAM_BOT_TOKEN=replace-with-telegram-bot-token
TELEGRAM_MASTER_ADMIN_ID=1026368027

# Import the bundled MariaDB dump into Supabase PostgreSQL once.
AUTO_MIGRATE_LEGACY_SQL=true
LEGACY_SQL_PATH=./legacy/legacy.sql

# Set to 1 during staging/release validation; set to 0 to run background workers.
PULSE_WORKERS_PAUSED=0

# Optional
SUBSCRIPTION_UPSTREAM_BASE_URL=
LEGACY_SUBSCRIPTION_BASE_URL=
USAGE_SYNC_INTERVAL_MS=60000
RAIN_GROUP_SYNC_INTERVAL_MS=21600000
RAIN_PHONEPANEL_USER=
RAIN_PHONEPANEL_PASS=
RAIN_SPEEDUR_USER=
RAIN_SPEEDUR_PASS=
