modules = ["nodejs-24", "python-base-3.13", "postgresql-16", "java-graalvm22.3"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["jdk17", "swig", "patch"]

[userenv]

[userenv.shared]
SUBSCRIPTION_BASE_URL = "/sub"

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 18828
externalPort = 80

[[ports]]
localPort = 25573
externalPort = 3000
